---
import Base from '../layouts/Base.astro';
import TarotSpread from '../components/TarotSpread.astro';
import Skills from '../components/Skills.astro';
import Chronicle from '../components/Chronicle.astro';
import Contact from '../components/Contact.astro';
import type { Locale } from '../data/site';
import { t } from '../i18n/ui';
interface Props { locale: Locale }
const { locale } = Astro.props;
---
<Base title={`${t(locale, 'about.title')} — Popong Faimoon`} {locale}>
  <div class="wrap about">
    <h1><span class="rune" aria-hidden="true">ᛗ</span> {t(locale, 'about.title')}</h1>
    <TarotSpread {locale} />
    <Skills {locale} />
    <Chronicle {locale} />
    <Contact {locale} />
  </div>
</Base>
<style>
  .about { padding-block: 24px 64px; display: grid; gap: 72px; }
  h1 { font-family: var(--font-display); font-weight: 500; font-size: clamp(44px, 6vw, 72px); margin: 0; }
  h1 .rune, .about :global(.block h2 .rune) { color: var(--gold-3); text-shadow: 0 0 14px var(--halo); }
  .about :global(.block h2) { font-family: var(--font-display); font-weight: 500; font-size: 34px; margin: 0 0 20px; border-bottom: 1px solid var(--hairline); padding-bottom: 10px; }
</style>
