---
import WorkDetail from '../../../views/WorkDetail.astro';
import { getProjects } from '../../../lib/projects';
export async function getStaticPaths() {
  const list = await getProjects('th');
  return list.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}
const { project } = Astro.props;
---
<WorkDetail locale="th" {project} />
