---
import { SKILLS } from '../data/cv';
import type { Locale } from '../data/site';
import { t } from '../i18n/ui';
interface Props { locale: Locale }
const { locale } = Astro.props;
---
<section id="skills" class="block" aria-labelledby="skills-h">
  <h2 id="skills-h"><span class="rune" aria-hidden="true">ᚲ</span> {t(locale, 'skills.title')}</h2>
  <dl class="skills">{SKILLS.map((s) => <div><dt>{s.group[locale]}</dt><dd>{s.items[locale]}</dd></div>)}</dl>
</section>
<style>
  .skills { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr)); gap: 20px 32px; margin: 0; }
  .skills dt { color: var(--gold-2); font-size: 13px; letter-spacing: .1em; }
  .skills dd { margin: 4px 0 0; color: var(--text-2); font-size: 13.5px; line-height: 1.65; }
</style>
