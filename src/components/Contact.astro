---
import { site, type Locale } from '../data/site';
import { t } from '../i18n/ui';
interface Props { locale: Locale }
const { locale } = Astro.props;
---
<section id="contact" class="block contact" aria-labelledby="contact-h">
  <h2 id="contact-h"><span class="rune" aria-hidden="true">ᚷ</span> {t(locale, 'contact.title')}</h2>
  <p>{t(locale, 'contact.body')}</p>
  <ul>
    <li><span>Email</span><a href={`mailto:${site.email}`}>{site.email}</a></li>
    <li><span>GitHub</span><a href={site.github} rel="me noopener">github.com/popongfm</a></li>
    <li><span>LinkedIn</span><a href={site.linkedin} rel="me noopener">linkedin.com/in/popong-faimoon</a></li>
  </ul>
</section>
<style>
  .contact p { color: var(--text-2); max-width: 560px; }
  .contact ul { list-style: none; padding: 0; margin: 16px 0 0; display: grid; gap: 10px; }
  .contact li { display: flex; gap: 16px; flex-wrap: wrap; align-items: baseline; }
  .contact li span { width: 80px; font-size: 11px; letter-spacing: .16em; text-transform: uppercase; color: var(--muted); }
  .contact a { font-size: 15px; padding: 6px 0; }
</style>
