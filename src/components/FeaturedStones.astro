---
import RuneGlyph from './RuneGlyph.astro';
import { RUNES } from '../data/runes';
import type { LocalizedProject } from '../lib/projects';
import type { Locale } from '../data/site';
import { t, localePath } from '../i18n/ui';
interface Props { projects: LocalizedProject[]; locale: Locale }
const { projects, locale } = Astro.props;
---
<section class="wrap" aria-labelledby="featured-h">
  <h2 id="featured-h" class="eyebrow">{t(locale, 'featured.label')}</h2>
  <ul class="stones">
    {projects.map((p) => (
      <li>
        <RuneGlyph char={RUNES[p.constellation].char} {locale} size={24} />
        <div>
          <h3><a href={localePath(locale, `/work/${p.slug}`)}>{p.title}</a></h3>
          <p>{p.summary}</p>
          {p.status === 'in-progress' && <span class="badge">{t(locale, 'status.inProgress')}</span>}
        </div>
      </li>
    ))}
  </ul>
</section>
<style>
  .eyebrow { font-family: var(--font-body); font-size: 11px; font-weight: 400; letter-spacing: .24em; text-transform: uppercase; color: var(--muted); margin: 0 0 16px; }
  .stones { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); gap: 20px; }
  .stones li { display: flex; gap: 16px; align-items: flex-start; background: var(--panel); border: 1px solid var(--hairline); border-radius: 48px 6px 6px 48px; padding: 16px 20px; position: relative; }
  .stones li > :global(.rune-glyph) { width: 50px; height: 50px; flex-shrink: 0; border: 1px solid #5C5137; border-radius: 50%; }
  .stones h3 { margin: 0 0 4px; font-family: var(--font-display); font-weight: 500; font-size: 22px; }
  .stones h3 a { color: var(--cream); text-decoration: none; }
  .stones h3 a::after { content: ''; position: absolute; inset: 0; border-radius: inherit; }
  .stones h3 a:hover { color: var(--gold-3); }
  .stones p { margin: 0; font-size: 12.5px; line-height: 1.6; color: #A9A28E; }
  .stones li > :global(.rune-glyph) { position: relative; z-index: 2; }
  .badge { display: inline-block; margin-top: 8px; font-size: 11px; letter-spacing: .1em; text-transform: uppercase; color: var(--ink); background: var(--gold-2); padding: 2px 8px; border-radius: 999px; }
</style>
