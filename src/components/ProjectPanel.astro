---
import type { Locale } from '../data/site';
import { t } from '../i18n/ui';
interface Props { locale: Locale }
const { locale } = Astro.props;
---
<aside id="panel" role="dialog" aria-modal="false" aria-labelledby="panel-title" hidden>
  <button type="button" class="panel-close" aria-label={t(locale, 'sky.close')}>✕</button>
  <div class="panel-body"></div>
</aside>
<style>
  #panel { position: fixed; z-index: 70; top: 0; right: 0; bottom: 0; width: min(520px, 100vw); background: rgba(13, 18, 36, .97); border-left: 1px solid #5C5137; padding: 56px 32px 40px; overflow-y: auto; box-shadow: -30px 0 60px rgba(0, 0, 0, .5); animation: slide-in .45s cubic-bezier(.2, .7, .2, 1); }
  #panel[hidden] { display: none; }
  @keyframes slide-in { from { transform: translateX(40px); opacity: 0; } }
  .panel-close { position: absolute; top: 10px; right: 12px; width: 44px; height: 44px; background: none; border: 1px solid #5C5137; color: var(--cream); font-size: 16px; cursor: pointer; border-radius: 50%; }
  .panel-close:hover { color: var(--gold-3); border-color: var(--gold-3); }
  #panel :global(.full) { display: inline-block; margin-top: 20px; }
  @media (max-width: 767px) {
    #panel { top: auto; left: 0; width: 100vw; max-height: 72vh; border-left: 0; border-top: 1px solid #5C5137; border-radius: 16px 16px 0 0; padding: 52px 20px 32px; animation-name: sheet-in; }
    @keyframes sheet-in { from { transform: translateY(40px); opacity: 0; } }
  }
</style>
