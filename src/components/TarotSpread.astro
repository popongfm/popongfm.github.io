---
import { existsSync } from 'node:fs';
import { TAROT } from '../data/tarot';
import type { Locale } from '../data/site';
import { t } from '../i18n/ui';
interface Props { locale: Locale }
const { locale } = Astro.props;
const cards = TAROT.map((c) => ({ ...c, image: existsSync(`public/tarot/${c.id}.webp`) ? `/tarot/${c.id}.webp` : undefined }));
---
<section class="tarot-wrap" aria-labelledby="tarot-h">
  <h2 id="tarot-h" class="visually-hidden">Tarot: past, present, future</h2>
  <p class="hint">{t(locale, 'tarot.hint')}</p>
  <ol class="tarot">
    {cards.map((c) => (
      <li>
        <p class="slot">{t(locale, `tarot.${c.slot}` as any)}</p>
        <button class="card" type="button" aria-expanded="false" aria-controls={`tarot-${c.id}`}>
          <span class="inner">
            <span class="face front">
              <span class="numeral">{c.numeral}</span>
              {c.image ? <img src={c.image} alt={`Popong as ${c.name}`} loading="lazy" /> : (
                <svg class="art" viewBox="0 0 100 140" aria-hidden="true" focusable="false">
                  {c.id === 'fool' && <g><path d="M10 112 L58 112 L58 128" /><circle cx="70" cy="34" r="12" /><path d="M42 106 l6 -22 l8 6 M48 84 l-4 -18 M44 66 l10 -6" /><path d="M20 30 l4 4 M84 70 l4 -4" /></g>}
                  {c.id === 'magician' && <g><path d="M30 30 c10 -12 30 12 40 0 c-10 12 -30 -12 -40 0z" /><path d="M50 50 v30 M50 56 l-14 -14 M50 70 l14 14" /><path d="M14 108 h72" /><rect x="20" y="96" width="10" height="12" /><circle cx="44" cy="102" r="5" /><path d="M62 108 l4 -12 l4 12" /><path d="M78 96 l4 6 l-4 6 l-4 -6z" /></g>}
                  {c.id === 'star' && <g><path d="M50 14 L54 40 L76 30 L60 48 L84 56 L58 60 L66 84 L50 66 L34 84 L42 60 L16 56 L40 48 L24 30 L46 40 Z" /><path d="M12 112 q12 -6 24 0 t24 0 t24 0 t12 0 M12 124 q12 -6 24 0 t24 0 t24 0 t12 0" /><circle cx="22" cy="20" r="1.5" /><circle cx="82" cy="18" r="1.5" /><circle cx="88" cy="88" r="1.5" /></g>}
                </svg>
              )}
              <span class="foot"><span class="rune" aria-hidden="true">{c.rune}</span><span class="card-name">{c.name}</span></span>
            </span>
            <span class="face back" id={`tarot-${c.id}`}>
              <span class="b-name">{c.name}</span>
              <span class="b-meaning">{c.meaning}</span>
              <span class="b-text">{c.text[locale] ?? c.text.en}</span>
            </span>
          </span>
        </button>
      </li>
    ))}
  </ol>
</section>
<script>
  document.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('.tarot button.card');
    if (b) b.setAttribute('aria-expanded', String(b.getAttribute('aria-expanded') !== 'true'));
  });
</script>
<style>
  .hint { color: var(--muted); font-size: 12px; letter-spacing: .14em; text-transform: uppercase; }
  .tarot { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr)); gap: 28px; }
  .tarot li { display: flex; flex-direction: column; align-items: center; gap: 10px; }
  .slot { margin: 0; font-size: 12px; letter-spacing: .24em; text-transform: uppercase; color: var(--gold-2); }
  .card { width: min(100%, 260px); aspect-ratio: 7 / 12; padding: 0; border: 0; background: none; perspective: 1200px; cursor: pointer; font: inherit; color: inherit; }
  .inner { position: relative; display: block; width: 100%; height: 100%; transform-style: preserve-3d; transition: transform .8s cubic-bezier(.2, .7, .2, 1); }
  .card[aria-expanded="true"] .inner { transform: rotateY(180deg); }
  .face { position: absolute; inset: 0; backface-visibility: hidden; border: 1px solid var(--gold); outline: 1px solid rgba(217, 185, 110, .35); outline-offset: -8px; border-radius: 10px; background: linear-gradient(180deg, #121A33, #0B1022); display: flex; flex-direction: column; align-items: center; padding: 18px 16px; gap: 10px; overflow: hidden; }
  .back { transform: rotateY(180deg); justify-content: center; text-align: center; }
  .numeral { font-family: var(--font-display); font-size: 22px; color: var(--gold-3); letter-spacing: .1em; }
  .art { flex: 1; width: 80%; fill: none; stroke: var(--gold-2); stroke-width: 1.4; stroke-linecap: round; stroke-linejoin: round; }
  .face img { flex: 1; width: 100%; min-height: 0; object-fit: cover; border-radius: 4px; }
  .foot { display: flex; flex-direction: column; align-items: center; gap: 2px; }
  .foot .rune { color: var(--gold-3); font-size: 20px; text-shadow: 0 0 12px var(--halo); }
  .card-name { font-family: var(--font-display); font-size: 20px; color: var(--cream); letter-spacing: .06em; }
  .b-name { font-family: var(--font-display); font-size: 24px; color: var(--gold-3); }
  .b-meaning { font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--muted); }
  .b-text { font-size: 13px; line-height: 1.7; color: var(--text-2); }
  .card:hover .face.front { border-color: var(--gold-3); }
</style>
